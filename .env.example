# Firebase (from Firebase Console → Project Settings → Your Apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate (Firebase Console → Project Settings → Cloud Messaging
# → Web configuration → Generate key pair). Public key, safe to expose.
VITE_FIREBASE_VAPID_KEY=

# Azure / Entra ID (from Azure Portal → App Registrations)
# Use your tenant ID (the GUID from Azure AD → Overview)
VITE_AZURE_TENANT_ID=

# --- Server-side only (Vercel env vars, NOT prefixed VITE_) ---

# Firebase Admin SDK (from Firebase Console → Project Settings → Service Accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (from resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=CMCHS Staff Schedule <noreply@yourcompany.com>

# Random secret — generate with: openssl rand -hex 32
CRON_SECRET=

# Your deployed Vercel URL (no trailing slash)
APP_URL=https://schedule.chsnz.co.nz

# Excel sync (api/sync-excel.js) — mirrors saved schedules into the existing
# company Excel schedule via Microsoft Graph. Same Azure app registration as
# Microsoft sign-in (VITE_AZURE_TENANT_ID above), plus a Files.ReadWrite
# Application permission + admin consent and a new client secret for it.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Resolve via Graph Explorer: GET /sites/{hostname}:/sites/{site-path}
SHAREPOINT_SITE_ID=
# Path to the .xlsx within that site's default document library
EXCEL_FILE_PATH=CMCHS Files/Admin/Cass Admin/Staff Schedule/CMCHS Staff Schedule 2024.xlsx
