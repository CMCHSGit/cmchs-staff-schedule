rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn()     { return request.auth != null; }
    function isAdmin()        { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(uid)     { return isSignedIn() && request.auth.uid == uid; }

    // Users — read own profile, admins read/write all
    match /users/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Locations — all signed-in users can read and add new ones (so a
    // location someone types while filling out their schedule becomes a
    // suggestion for everyone); only admins can edit or remove existing ones.
    match /locations/{locId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active == true;
      allow update, delete: if isAdmin();
    }

    // Schedules — users read/write their own, all signed-in users read any (for team view)
    match /schedules/{schedId} {
      allow read:  if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
