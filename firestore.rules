rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn()     { return request.auth != null; }
    function isAdmin()        { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(uid)     { return isSignedIn() && request.auth.uid == uid; }
    // HR (the hub's People page): admins, plus anyone an admin flags hr: true.
    function isHR()           { return isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('hr', false) == true); }
    // People's private records are keyed by their lower-case work email.
    function isMyEmail(email) { return isSignedIn() && email != '' && request.auth.token.get('email', '').lower() == email; }
    // Maintenance schedule: the service side of the business keeps it, so the
    // Engineers and Management teams can edit as well as admins. Everyone
    // signed in can read it — knowing what PM is due where is not sensitive,
    // and account managers need to see it without being able to change it.
    function canEditMaintenance() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.team in ['Engineers', 'Management']
      );
    }

    // Users — all signed-in users can read the whole roster (Team view needs
    // everyone's name/team, not just their own — this was previously
    // owner-or-admin-only, which meant Team view silently broke for any
    // non-admin signed-in user; only ever worked because testing so far has
    // all been done as an admin). Create/update still owner-or-admin-only.
    // Delete additionally allows removing a "pending" placeholder record
    // (Admin's bulk-import feature) once claimed by a real sign-in — but
    // never a real (non-pending) account, which stays admin-only.
    //
    // What people may write about THEMSELVES is deliberately narrow. Until
    // 14 Oct 2026 an owner could write any field on their own record, which
    // meant anyone signed in could set role:'admin' or simproAccess:true from
    // the browser console — and admin is what the Apps Script proxy trusts for
    // Simpro writes. Every legitimate owner write is one of these three:
    //   - the profile created on first sign-in (AuthContext.jsx), always
    //     role 'user', possibly carrying a team claimed from a placeholder
    //   - choosing a team once, while it is still empty (TeamOnboarding.jsx)
    //   - registering a phone for push (push.js: fcmTokens)
    // Anything else about a person — role, simproAccess, changing a team once
    // set — is an admin's to change.
    //
    // Since the hub's People page: people may also change their own name and
    // work mobile; HR may add placeholders (with a work email), change anyone's
    // name, team, work email and work mobile, and remove anyone but an admin.
    // Only an admin can set role, simproAccess or hr.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isOwner(uid) && isNewOwnProfile()) || (isHR() && isHRNewPerson());
      allow update: if isAdmin() || (isOwner(uid) && isOwnSafeUpdate()) || (isHR() && isHRSafeUpdate());
      // A placeholder is claimed during someone's FIRST sign-in, before their
      // own record is written (AuthContext: claimPendingProfile runs before
      // setDoc). So only a person with no record yet may remove one — which
      // stops anyone already signed in from deleting other people's
      // placeholders, without copying the claim's fuzzy name matching here.
      allow delete: if isAdmin() || (isHR() && resource.data.get('role', 'user') != 'admin') || (
        isSignedIn() &&
        resource.data.pending == true &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function isNewOwnProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'email', 'team', 'role', 'excelName', 'workMobile', 'createdAt'])
        && d.role == 'user';
    }

    function isOwnSafeUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['team', 'fcmTokens', 'displayName', 'workMobile'])
        && (!changed.hasAny(['team']) || resource.data.get('team', null) in [null, ''])
        && (!changed.hasAny(['displayName']) || isShortText(request.resource.data.displayName, 1, 80))
        && (!changed.hasAny(['workMobile']) || isShortText(request.resource.data.workMobile, 0, 40));
    }

    function isShortText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    function isHRNewPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'email', 'team', 'role', 'pending', 'workMobile', 'createdAt'])
        && d.role == 'user' && d.pending == true;
    }

    function isHRSafeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'team', 'workMobile']);
    }

    // The hub's People page (HR profiles), keyed by lower-case work email.
    // Pictures are visible to everyone signed in; personal and job details
    // only to the person and HR. The person keeps their own personal details
    // and job title; the rest of the job details are HR's.
    match /staffPhotos/{email} {
      allow read: if isSignedIn();
      allow create, update: if (isMyEmail(email) || isHR())
        && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('data:image/jpeg;base64,.*')
        && request.resource.data.photo.size() < 200000;
      allow delete: if isMyEmail(email) || isHR();
    }
    match /staffPrivate/{email} {
      allow read, delete: if isMyEmail(email) || isHR();
      allow create, update: if (isMyEmail(email) || isHR())
        && request.resource.data.keys().hasOnly(['dateOfBirth', 'personalEmail', 'personalPhone', 'address', 'emergency', 'updatedAt', 'updatedBy']);
    }
    match /staffEmployment/{email} {
      allow read: if isMyEmail(email) || isHR();
      allow delete: if isHR();
      allow create: if (isHR() && isEmploymentDoc()) || (isMyEmail(email) && request.resource.data.keys().hasOnly(['jobTitle', 'updatedAt']));
      allow update: if (isHR() && isEmploymentDoc()) || (isMyEmail(email) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobTitle', 'updatedAt']));
    }
    function isEmploymentDoc() {
      return request.resource.data.keys().hasOnly(['jobTitle', 'startDate', 'employmentType', 'managerUid', 'updatedAt']);
    }

    // Locations — all signed-in users can read and add new ones (so a
    // location someone types while filling out their schedule becomes a
    // suggestion for everyone); only admins can edit or remove existing ones.
    match /locations/{locId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active == true;
      allow update, delete: if isAdmin();
    }

    // Schedules — everyone signed in can read (Team week, Day, Leave). People
    // write their own; admins can write anyone's (filling in from Team week,
    // "Copy last week", people who haven't signed in yet). A non-admin can
    // never hand a schedule to someone else by changing its uid.
    match /schedules/{schedId} {
      allow read:  if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // Weekly on-call roster, one doc per week (id = the Monday). Everyone
    // can see it; only admins assign it.
    match /oncall/{weekStart} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Activity log — "who changed what", read on Admin → Activity log.
    // Anyone signed in can log their own action (so a non-admin saving their
    // own week or booking their own leave still gets recorded); only admins
    // can read it back. Immutable: no update or delete, not even for admins —
    // an audit trail that can be edited isn't one.
    match /activity/{entryId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Maintenance schedule (internal.chsnz.co.nz/maintenance/) — replaces the
    // PM tracking spreadsheet. One document per scheduled PM.
    match /maintenance/{entryId} {
      allow read:   if isSignedIn();
      allow create, update, delete: if canEditMaintenance();
    }

    // Service orders (internal.chsnz.co.nz/service-orders/) — replaces the
    // service order spreadsheet. One document per order line. Kept by the
    // same people as the maintenance schedule.
    match /serviceOrders/{orderId} {
      allow read:   if isSignedIn();
      allow create, update, delete: if canEditMaintenance();
    }

    // Project tracker (internal.chsnz.co.nz/projects/) — replaces the project
    // team's job register and weekly timeline sheets. Everyone signed in can
    // read; anyone with a team set (or an admin) can edit, as on the shared
    // sheets. The tracker's buttons follow the same test (store.jsx canEdit).
    function canEditProjects() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', '') in ['Admin', 'Management', 'Engineers', 'Sales', 'Application']
      );
    }
    match /projectJobs/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditProjects();
    }
    // Who is where each week: one record per person, job, week and activity.
    match /projectAssignments/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if canEditProjects();
    }
    match /projectSettings/{id} {
      allow read: if isSignedIn();
      allow create, update: if canEditProjects();
    }
    // Comments are signed by their author and never edited. Editors can
    // delete them (their own, or with a job that is being deleted). An admin
    // can also re-add other people's, to restore them from a backup (the
    // tracker's Settings → Backups).
    match /projectComments/{id} {
      allow read:   if isSignedIn();
      allow create: if canEditProjects() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if canEditProjects();
    }
    // A job's change history: written as yourself, never edited. Only the
    // sample jobs' history can be removed (Settings → Remove sample data). An
    // admin can re-add other people's entries when restoring a backup.
    match /projectHistory/{id} {
      allow read:   if isSignedIn();
      allow create: if canEditProjects() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if canEditProjects() && resource.data.jobId.matches('sample-.*');
    }
    // Company news (the hub's Manage → News, shown on the hub home page).
    // Anyone on a team posts, as themselves; the author, an admin or HR edits
    // and deletes. Photos sit apart so the home page only fetches the ones it
    // shows; anyone who may post may set one.
    function isEngineering() {
      return isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', '') == 'Engineers');
    }
    match /announcements/{id} {
      allow read:   if isSignedIn();
      allow create: if canEditProjects() && request.resource.data.authorUid == request.auth.uid && isAnnouncement();
      allow update: if (resource.data.authorUid == request.auth.uid || isAdmin() || isHR())
        && request.resource.data.authorUid == resource.data.authorUid && isAnnouncement();
      allow delete: if resource.data.authorUid == request.auth.uid || isAdmin() || isHR();
    }
    function isAnnouncement() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.get('body', '') is string && d.get('body', '').size() <= 4000;
    }
    match /announcementPhotos/{id} {
      allow read: if isSignedIn();
      allow create, update: if canEditProjects()
        && request.resource.data.keys().hasOnly(['photo'])
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('data:image/jpeg;base64,.*')
        && request.resource.data.photo.size() < 600000;
      allow delete: if canEditProjects() || isHR();
    }

    // Tool requests and feedback (Manage → Tool requests / Feedback). Tool
    // requests are public so people can +1 them; feedback is seen only by
    // its author and the engineering team (Engineers, and admins). Anyone
    // adds one as themselves; anyone may add or take back their own +1; only
    // the engineering team sets the status and replies.
    match /hubRequests/{id} {
      allow read: if isSignedIn() && (resource.data.kind == 'tool' || resource.data.uid == request.auth.uid || isEngineering());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['tool', 'feedback']
        && request.resource.data.status == 'new'
        && request.resource.data.get('response', '') == ''
        && (request.resource.data.kind == 'feedback' || request.resource.data.votes == [request.auth.uid]);
      allow update: if (isEngineering() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response', 'respondedBy', 'updatedAt']))
        || (isSignedIn() && resource.data.kind == 'tool' && isOwnVoteChange());
      allow delete: if isAdmin() || (resource.data.uid == request.auth.uid && resource.data.status == 'new');
    }
    function isOwnVoteChange() {
      let before = resource.data.get('votes', []).toSet();
      let after = request.resource.data.get('votes', []).toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    // Who has the tracker open: each person writes only their own record.
    match /projectPresence/{uid} {
      allow read:  if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Asks (internal.chsnz.co.nz/asks/) — quick requests between staff,
    // picked up by whoever can do them. An ask is seen only by the people
    // involved: whoever asked, the people and whole teams it was sent to,
    // whoever picked it up or was @mentioned (all named in `people`), plus
    // admins. Anyone involved may change it — pick it up, hand it back, mark
    // it done, comment — but only for themselves: taking an ask someone else
    // has is for its owner, the asker or an admin. The asker or an admin
    // deletes. askStats mirrors the counting fields with no text at all, so
    // the Company page can show everyone's load to everyone; its rule checks
    // it matches the ask exactly, so it can't be used to say anything else.
    function myTeam() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', ''); }
    function canSeeAsk(a) {
      return isSignedIn() && (request.auth.uid in a.people || (myTeam() is string && myTeam() in a.teams) || isAdmin());
    }
    function isAsk(d) {
      return d.keys().hasOnly(['title', 'details', 'createdBy', 'createdByName', 'createdAtMs', 'updatedAtMs',
          'assignees', 'teams', 'people', 'owner', 'ownerName', 'status', 'waitingOn', 'urgent', 'due',
          'doneAtMs', 'doneBy', 'photoCount', 'commentCount', 'lastCommentAtMs', 'lastCommentBy', 'event'])
        && isShortText(d.title, 1, 200) && isShortText(d.details, 0, 4000)
        && d.createdBy is string && d.createdAtMs is number && d.doneAtMs is number
        && d.status in ['open', 'picked', 'waiting', 'done']
        && d.assignees is list && d.assignees.size() <= 40
        && d.teams is list && d.teams.hasOnly(['Admin', 'Management', 'Engineers', 'Sales', 'Application'])
        && d.assignees.size() + d.teams.size() > 0
        && d.people is list && d.people.size() <= 60 && d.createdBy in d.people
        && d.owner is string && (d.owner == '' || d.owner in d.people)
        // Nobody has an open one; somebody has one being worked on or waiting.
        && (d.status != 'open' || d.owner == '')
        && (!(d.status in ['picked', 'waiting']) || d.owner != '')
        && isShortText(d.waitingOn, 0, 120) && d.urgent is bool
        && d.due is string && (d.due == '' || d.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && (d.get('event', null) == null || d.event is map);
    }
    function isFairOwnerChange() {
      let before = resource.data.owner;
      let after = request.resource.data.owner;
      return after == before
        || (before == '' && after == request.auth.uid)
        || before == request.auth.uid || resource.data.createdBy == request.auth.uid || isAdmin();
    }
    match /asks/{id} {
      allow read: if canSeeAsk(resource.data);
      allow create: if isSignedIn() && isAsk(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if canSeeAsk(resource.data) && isAsk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && isFairOwnerChange();
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());

      // The conversation: signed by its author, never edited. The author, the
      // asker or an admin deletes one; an admin can re-add anyone's (restoring
      // a backup). getAfter, so a comment that @mentions someone new and the
      // ask's updated people list can be saved together.
      match /comments/{cid} {
        allow read: if canSeeAsk(get(/databases/$(database)/documents/asks/$(id)).data);
        allow create: if canSeeAsk(getAfter(/databases/$(database)/documents/asks/$(id)).data)
          && (request.resource.data.uid == request.auth.uid || isAdmin())
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'atMs', 'mentions', 'photoIds'])
          && isShortText(request.resource.data.text, 0, 4000)
          && request.resource.data.mentions is list && request.resource.data.photoIds is list && request.resource.data.photoIds.size() <= 6;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()
          || get(/databases/$(database)/documents/asks/$(id)).data.createdBy == request.auth.uid);
      }
      // Photos from site: one shrunk JPEG per document (apps/asks/src/photos.js).
      match /photos/{pid} {
        allow read: if canSeeAsk(get(/databases/$(database)/documents/asks/$(id)).data);
        allow create: if canSeeAsk(getAfter(/databases/$(database)/documents/asks/$(id)).data)
          && (request.resource.data.uid == request.auth.uid || isAdmin())
          && request.resource.data.keys().hasOnly(['uid', 'data', 'w', 'h', 'atMs', 'commentId'])
          && request.resource.data.data is string
          && request.resource.data.data.matches('data:image/jpeg;base64,.*')
          && request.resource.data.data.size() < 500000;
        allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()
          || get(/databases/$(database)/documents/asks/$(id)).data.createdBy == request.auth.uid);
      }
    }
    match /askStats/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data == askStatsOf(getAfter(/databases/$(database)/documents/asks/$(id)).data);
      allow delete: if isSignedIn() && !existsAfter(/databases/$(database)/documents/asks/$(id));
    }
    function askStatsOf(a) {
      return {
        'status': a.status, 'owner': a.owner, 'assignees': a.assignees, 'teams': a.teams, 'due': a.due,
        'urgent': a.urgent, 'createdBy': a.createdBy, 'createdAtMs': a.createdAtMs, 'doneAtMs': a.doneAtMs
      };
    }
  }
}
